import { GoogleGenerativeAI } from "@google/generative-ai";
import { NextResponse } from 'next/server';

export async function POST(request) {
  try {
    const { tipe, dataInput } = await request.json();
    
    // Cek apakah API Key terbaca dari .env.local
    const apiKey = process.env.GEMINI_API_KEY;
    
    if (!apiKey) {
      console.error("❌ ERROR: API Key tidak ditemukan di .env.local!");
      return NextResponse.json({ success: false, error: "API Key belum terpasang di server." }, { status: 500 });
    }

    const genAI = new GoogleGenerativeAI(apiKey);
    const modelsToTry = ["gemini-1.5-flash", "gemini-2.0-flash","gemini-3.0-flash", "gemini-1.5-pro", "gemini-2.0-pro", "gemini-3.0-pro", "gemini-1.5", "gemini-2.0", "gemini-3.0"

    ];
    
    let prompt = "";
    let visualData = null;

    if (tipe === 'suara') {
      prompt = `Ekstrak transaksi ini jadi JSON: "${dataInput}". Format: {"tanggal": "${new Date().toISOString().split('T')[0]}", "jenis": "Penjualan", "keterangan": "Input Suara", "total": 10000}`;
    } else if (tipe === 'foto') {
      prompt = `Ambil total harga dari nota ini. Format: {"tanggal": "${new Date().toISOString().split('T')[0]}", "jenis": "Pengeluaran", "keterangan": "Scan Nota", "total": 10000}`;
      visualData = {
        inlineData: {
          data: dataInput.split(',')[1],
          mimeType: "image/jpeg"
        }
      };
    }

    let lastError = "";
    for (const m of modelsToTry) {
      try {
        console.log(`🤖 Mencoba Model: ${m}...`);
        const model = genAI.getGenerativeModel({ model: m });
        
        const content = visualData ? [prompt, visualData] : [prompt];
        const res = await model.generateContent(content);
        
        const response = await res.response;
        const text = response.text();
        
        if (text) {
          console.log(`✅ Berhasil dengan model ${m}!`);
          const cleanJson = text.replace(/```json|```/g, "").trim();
          return NextResponse.json({ success: true, data: JSON.parse(cleanJson) });
        }
      } catch (err) {
        lastError = err.message;
        console.error(`❌ Gagal di ${m}:`, lastError);
        continue; 
      }
    }

    return NextResponse.json({ success: false, error: `Semua model gagal: ${lastError}` }, { status: 500 });

  } catch (error) {
    console.error("🔥 Fatal Error:", error.message);
    return NextResponse.json({ success: false, error: error.message }, { status: 500 });
  }
}